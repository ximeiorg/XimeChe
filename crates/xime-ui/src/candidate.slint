import { VerticalBox, HorizontalBox, Text, Rectangle, Window } from "std-widgets.slint";

export component CandidateWindow inherits Window {
    in property <[string]> candidates: [];
    in property <int> highlighted-index: 0;
    in property <int> page-size: 5;
    
    property <int> window-width: 300px;
    property <int> window-height: candidates.length * 30px + 10px;
    
    width: window-width;
    height: window-height;
    background: #f0f0f0;
    border-radius: 5px;
    
    VerticalBox {
        padding: 5px;
        
        for item[index] in candidates: Rectangle {
            height: 30px;
            background: index == highlighted-index ? #4a90d9 : transparent;
            border-radius: 3px;
            
            HorizontalBox {
                padding: 5px;
                
                Text {
                    text: (index + 1) + ". " + item;
                    color: index == highlighted-index ? white : black;
                    font-size: 14px;
                }
            }
        }
    }
}
